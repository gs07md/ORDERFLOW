<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/m_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/widget_bg"
    android:paddingStart="16dp" android:paddingEnd="12dp" android:paddingTop="10dp" android:paddingBottom="10dp">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Spent today"
            android:textSize="12sp" android:textColor="@color/w_muted"/>
        <TextView android:id="@+id/m_today" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="24sp" android:textStyle="bold" android:textColor="@color/w_ink" android:singleLine="true"/>
        <TextView android:id="@+id/m_month" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="12.5sp" android:textColor="@color/w_muted" android:singleLine="true" android:ellipsize="end"/>
    </LinearLayout>
    <TextView android:id="@+id/m_add" android:layout_width="52dp" android:layout_height="52dp" android:gravity="center"
        android:background="@drawable/widget_btn" android:text="+ ₹" android:textSize="16sp" android:textStyle="bold"
        android:textColor="#FFFFFF" android:contentDescription="Add expense"/>
</LinearLayout>
